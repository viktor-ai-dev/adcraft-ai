datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  createdAt DateTime @default(now())

  ads       Ad[]
}

model Ad {
  id          String   @id @default(cuid())

  name        String
  description String
  style       String
  prompt      String?

  // IMPORTANT: JSON is correct for multiple images
  images      String

  createdAt   DateTime @default(now())

  // RELATION (SAAS CORE)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}