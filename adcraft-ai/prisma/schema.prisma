datasource db {
  provider = "sqlite" // senare: postgresql
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id // 👈 Clerk userId direkt!
  email     String?
  name      String?
  createdAt DateTime @default(now())

  ads       Ad[]
}

model Ad {
  id          String   @id @default(cuid())

  name        String
  description String
  style       String
  prompt      String?

  images      String

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}